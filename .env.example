# Database (local uvicorn / reference only — deploy scripts set container DB_*; dev server .env should use DB_NAME=evergreen_dev)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=evergreen

# JWT / auth (match your existing deployment)
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Myco web app base URL (fallback when request origin / stored notice URL unavailable, e.g. cron)
MYCO_CLIENT_URL=https://myco.evergreenpodcasts.com
# Optional extra allowed Myco app hosts for X-Myco-Client-Url / Origin (comma-separated hostnames)
# MYCO_CLIENT_URL_ALLOWLIST=staging.example.com
# Prod Myco URL for email footer logo (image + link — always prod, publicly reachable)
MYCO_PROD_CLIENT_URL=https://myco.evergreenpodcasts.com
# Optional full overrides for email footer logo images
# MYCO_EMAIL_LOGO_URL=https://myco.evergreenpodcasts.com/myco-beta-footer-logo.png
# MYCO_EMAIL_LOGO_DARK_URL=https://myco.evergreenpodcasts.com/myco-beta-footer-logo-light.png

# Gmail — Myco Notices email (service account + domain-wide delegation)
GMAIL_SERVICE_ACCOUNT_JSON_PATH=/secrets/gmail-service-account.json
GMAIL_IMPERSONATE_USER=myco@evergreenpodcasts.com
GMAIL_SENDER_EMAIL=myco@evergreenpodcasts.com
GMAIL_SENDER_NAME="Myco Notices"
# Optional: retry transient DNS/network errors when calling Gmail API
GMAIL_SEND_MAX_ATTEMPTS=3
GMAIL_SEND_RETRY_DELAY_SECONDS=2

# Twilio — Myco Notices SMS
# Production auth uses an API Key (Standard) instead of the account Auth Token.
# Create at Console → Account → API keys & tokens → Create API key (type: Standard).
# The secret is shown only once at creation — store it securely, never commit it.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_FROM_NUMBER=+13854546186
# Optional: webhook URL for real-time SMS delivery status (POST). Status is also polled on notice detail load.
# TWILIO_STATUS_CALLBACK_URL=https://myco.evergreenpodcasts.com/api/webhooks/twilio/sms-status
# Optional: primary Auth Token — used only to validate Twilio webhook signatures when set.
# TWILIO_AUTH_TOKEN=
